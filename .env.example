# Required for the optional Python Discord gateway/transcript producer.
DISCORD_TOKEN=your_discord_bot_token_here

# Dedicated HMAC secret shared with the Cloudflare Worker.
# Generate a long random value; never commit the real secret.
CAPTION_INGEST_SECRET=replace_with_a_long_random_secret
CAPTION_CACHE_URL=https://discord-youtube-transcripts.kaiguy432.workers.dev/caption-cache
# Required by the Summary button. Use a Cloudflare secret in production.
GEMINI_API_KEY=

# Local-only route persistence. Cloud production uses D1.
SUBSCRIPTIONS_FILE=./subscriptions.json
SUBSCRIPTIONS_SEED_B64=
LOCAL_FEED_POLLING=false

# Optional legacy Reddit commands.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
